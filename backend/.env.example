# --- Required -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Search providers -----------------------------------------------------------
# Web search. Optional: without it, research uses scholarly papers + Wikipedia only.
TAVILY_API_KEY=
# OpenAlex (papers) and Wikipedia need no key. A contact email joins OpenAlex's faster pool.
# OPENALEX_EMAIL=you@example.com
# SEARCH_PROVIDERS=["web","academic","reference"]
# RESULTS_PER_QUERY=5
# ACADEMIC_RESULTS_PER_QUERY=3
# REFERENCE_RESULTS_PER_QUERY=2

# --- Model ----------------------------------------------------------------------
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_FALLBACKS=true

# --- Research breadth -----------------------------------------------------------
# MAX_TOPICS=5
# MAX_SOURCES_PER_TOPIC=6

# --- API --------------------------------------------------------------------------
# DATABASE_PATH=researchgraph.db
# CORS_ORIGINS=["http://localhost:3000"]
# MAX_CONCURRENT_RUNS=3
# RUNS_PER_HOUR_PER_CLIENT=20
# TRUST_PROXY_HEADERS=false
# DEMO_MODE=false

# --- Observability (LangSmith traces every graph step and model call) ---------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=researchgraph
